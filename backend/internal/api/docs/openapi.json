  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "dev_<64 hex chars>",
        "description": "API key sent as a Bearer token in the `Authorization` header (the middleware also accepts the legacy `Authentication` header):\n\n```\nAuthorization: Bearer dev_<64 hex characters>\n```\n\nCreate or manage keys in the developer dashboard (**Api keys** page)."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request is missing or malformed (invalid path value, invalid JSON body, wrong domain, invalid expiry, etc.).",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, malformed, unknown, or revoked API key.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "The authenticated developer is not allowed to access the requested resource (for example another developer's mailbox).",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "The requested mailbox, message, attachment, webhook, or dead letter does not exist (or does not belong to the developer).",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Conflict": {
        "description": "The request conflicts with the current state of the resource (mailbox already exists, mailbox already linked, webhook inactive).",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "TooManyRequests": {
        "description": "The developer's usage quota was exceeded (`{\"error\":\"usage quota exceeded\"}`) or the IP rate limit was reached.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "InternalServerError": {
        "description": "An unexpected server error occurred.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable error message."
          }
        },
        "required": ["error"]
      },
      "RequestEmail": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "For `POST /api/v1/mailboxes` this must be a full mailbox address on the configured mail domain (for example `dev-123@temp.mail.at`). For `POST /api/v1/mailboxes/custom` this is the local part (for example `dev-123`), which is sanitized and combined with the mail domain."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Optional expiry timestamp. Must be in the future; omitted to use the default mailbox lifetime."
          }
        },
        "required": ["username"]
      },
      "Mailbox": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Mailbox id. Present on get/list responses; not returned when a mailbox is created."
          },
          "address": { "type": "string", "description": "Full mailbox address." },
          "createdAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "createdBy": {
            "type": ["string", "null"],
            "format": "uuid",
            "description": "Developer id that created the mailbox, or null for public mailboxes."
          }
        },
        "required": ["address", "createdAt", "expiresAt", "createdBy"]
      },
      "DeletedMailbox": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "mailbox deleted" },
          "address": { "type": "string" },
          "id": { "type": "string", "format": "uuid" }
        },
        "required": ["message", "address", "id"]
      },
      "MessagePreview": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "sender": { "type": "string", "example": "sender@example.com" },
          "subject": { "type": "string" },
          "preview": { "type": "string", "description": "Plain-text preview of the message body." },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "sender", "subject", "preview", "createdAt"]
      },
      "MessagesResult": {
        "type": "object",
        "properties": {
          "address": { "type": "string" },
          "messages": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MessagePreview" }
          },
          "messageCount": { "type": "integer" }
        },
        "required": ["address", "messages", "messageCount"]
      },
      "AttachmentInfo": {
        "type": "object",
        "properties": {
          "filename": { "type": "string" },
          "contentType": { "type": "string" },
          "size": { "type": "integer", "description": "Attachment size in bytes." },
          "contentId": { "type": "string" },
          "index": { "type": "integer", "description": "Zero-based index used to fetch the attachment." },
          "inline": { "type": "boolean", "description": "True for inline (embedded) parts such as images." }
        },
        "required": ["filename", "contentType", "size", "contentId", "index", "inline"]
      },
      "ParsedData": {
        "type": "object",
        "properties": {
          "subject": { "type": "string" },
          "from": { "type": "string" },
          "text": { "type": "string", "description": "Plain-text body." },
          "html": { "type": "string", "description": "HTML body." },
          "attachments": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AttachmentInfo" }
          }
        },
        "required": ["subject", "from", "text", "html", "attachments"]
      },
      "MessageDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "from": { "type": "string", "example": "sender@example.com" },
          "subject": { "type": "string" },
          "body": {
            "type": "string",
            "description": "Base64-encoded raw MIME message (the Go server serializes the raw message bytes as base64)."
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "mailbox": { "type": "string", "description": "Mailbox address the message belongs to." },
          "parsedData": { "$ref": "#/components/schemas/ParsedData" }
        },
        "required": ["id", "from", "subject", "body", "createdAt", "mailbox", "parsedData"]
      },
      "WebhookCreateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Optional label; defaults to the endpoint URL when omitted." },
          "url": { "type": "string", "format": "uri", "example": "https://example.com/webhooks/receiver" },
          "events": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/WebhookEvent" },
            "description": "Events the webhook subscribes to. At least one is required."
          },
          "mailbox_ids": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" },
            "description": "Mailboxes to link to the webhook. At least one is required."
          }
        },
        "required": ["url", "events", "mailbox_ids"]
      },
      "WebhookUpdateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "is_active": { "type": "boolean", "description": "Pause or resume delivery of events." }
        }
      },
      "WebhookEventsRequest": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/WebhookEvent" },
            "description": "Events to add to or remove from the webhook. At least one is required."
          }
        },
        "required": ["events"]
      },
      "WebhookMailboxRequest": {
        "type": "object",
        "properties": {
          "mailbox_id": { "type": "string", "format": "uuid" }
        },
        "required": ["mailbox_id"]
      },
      "Webhook": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "developer_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "is_active": { "type": "boolean" },
          "events": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/WebhookEvent" }
          },
          "secret": {
            "type": "string",
            "description": "Webhook signing secret sent in the `X-Webhook-Signature` header of deliveries. Only returned when a webhook is first created."
          },
          "mailbox_ids": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          }
        },
        "required": ["id", "developer_id", "name", "url", "is_active", "events", "mailbox_ids"]
      },
      "WebhookEvent": {
        "type": "string",
        "enum": ["email.received", "email.deleted", "mailbox.expired"],
        "description": "The events a webhook can subscribe to."
      },
      "WebhookDeleted": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "webhook deleted" },
          "id": { "type": "string", "format": "uuid" }
        },
        "required": ["message", "id"]
      },
      "WebhookMailboxResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "mailbox added to webhook" },
          "mailbox_id": { "type": "string", "format": "uuid" }
        },
        "required": ["message", "mailbox_id"]
      },
      "WebhookTestResult": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "True when the endpoint replied with a 2xx status."
          },
          "statusCode": { "type": "integer", "description": "HTTP status code returned by the webhook endpoint." }
        },
        "required": ["success", "statusCode"]
      },
      "DeadLetter": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "webhook_id": { "type": "string", "format": "uuid" },
          "mailbox_id": { "type": ["string", "null"], "format": "uuid" },
          "mailbox_address": { "type": ["string", "null"] },
          "message_id": { "type": ["string", "null"], "format": "uuid" },
          "message_sender": { "type": ["string", "null"] },
          "message_subject": { "type": ["string", "null"] },
          "event": { "$ref": "#/components/schemas/WebhookEvent" },
          "url": { "type": "string", "description": "The webhook endpoint the delivery was attempted against." },
          "reason": { "type": "string", "description": "Why the delivery failed." },
          "attempts": { "type": "integer" },
          "seen": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "required": [
          "id",
          "webhook_id",
          "mailbox_id",
          "mailbox_address",
          "message_id",
          "message_sender",
          "message_subject",
          "event",
          "url",
          "reason",
          "attempts",
          "seen",
          "created_at"
        ]
      },
      "DeadLetterSeen": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "dead letter marked as seen" },
          "id": { "type": "string", "format": "uuid" }
        },
        "required": ["message", "id"]
      }
    }
  }
}